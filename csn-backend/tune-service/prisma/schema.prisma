datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tune {
  id             String   @id @default(uuid())
  sequenceNumber Int      @default(autoincrement())
  ownerId        String
  title          String
  genre          String
  language       String
  mood           String
  bpm            Int?
  audioUrl       String
  duration       Float?
  status         String   @default("READY")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
